@page "/ChangePwd"
@using Models;
@inject NavigationManager navManager

<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <div class="mb-3 text-center">
            <h3>Login</h3>
        </div>
        <div class="mb-3">
            <label>Current Password</label>
            <input @bind="changePwdRequest.CurrentPwd" class="form-control" placeholder="Current Password" />
        </div>
        <div class="mb-3">
            <label>New Password</label>
            <input @bind="changePwdRequest.NewPwd" type="password" class="form-control" placeholder="New Password" />
        </div>
        <div class="mb-3">
            <label>Confirm Password</label>
            
            <input @bind="changePwdRequest.ConfirmPwd" type="password" class="form-control" placeholder="Confirm Password" />
        </div>
        <div>
            <button @onclick="SaveNewPassoword" class="btn btn-primary">Save</button>
           
        </div>
    </div>
</div>
@code {
    private ChangePwdRequest changePwdRequest = new ChangePwdRequest();
    private async Task SaveNewPassoword()
    {
        await Task.Delay(1);
    }
}
