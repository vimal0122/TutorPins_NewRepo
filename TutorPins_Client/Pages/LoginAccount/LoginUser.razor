@page "/loginuser"
@using TutorPins_Client.Authentication;
@inject HttpClient httpClient
@inject IJSRuntime js
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager
@inject IUserService userService

<style>
    .e-input-eye:before {
        content: '\e345';
        font-family: e-icons;
        font-size: 13px;
    }
</style>
<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <div class="mb-3 text-center">
            <h3>Login</h3>
        </div>
        <div class="mb-3">
            <label>User Name</label>
            <input @bind="loginRequest.UserName"  class="form-control" placeholder="User Name" />
        </div>
        <div class="mb-3">
            <label>Password</label>
            <input @bind="loginRequest.Password" type="password" class='e-input' placeholder="Password" />
        </div>
        <div>
            <button @onclick="Authenticate" class="btn btn-primary">Login</button>
            <span style="text-align:right"> 
            <SfButton Content="Forgot Password" class="getstarted scrollto" title="Log" OnClick="@(()=>ShowForgotPwdForm())"></SfButton>
            </span>
        </div>
    </div>
</div>
<SfDialog @ref="ForgotDialog" Width="580px" Visible="false" ShowCloseIcon="true" IsModal="true">
    <DialogEvents Closed="ForgotClosed"></DialogEvents>
    <DialogTemplates>
        @*Here you can customize the Header and Content of delete confirmation dialog*@
        <Header> Forgot Password</Header>
        <Content>
            <div class="row">
            
            <div class="col-sm-8">
                <SfTextBox Placeholder="Email" @bind-Value="@UserEmail" CssClass="e-corner e-input-group" ></SfTextBox>
            </div>
                <div class="col-sm-1">
                    <SfButton CssClass="e-info" >Submit</SfButton>
                </div>
            </div>
        </Content>
    </DialogTemplates>

</SfDialog>
<SfDialog @ref="ChangePwdDialog" Width="580px" Visible="false" ShowCloseIcon="true" IsModal="true">
    <DialogEvents Closed="ChangePwdClosed"></DialogEvents>
    <DialogTemplates>
        @*Here you can customize the Header and Content of delete confirmation dialog*@
        <Header> Change Password</Header>
        <Content>
            <div class="mb-3">
                <label>Current Password</label>
                <input @bind="changePwdRequest.CurrentPwd" type="password" class='e-input'   placeholder="Current Password" />
            </div>
            <div class="mb-3">
                <label>New Password</label>
                <input @bind="changePwdRequest.NewPwd" type="password" class='e-input' placeholder="New Password" />
            </div>
            <div class="mb-3">
                <label>Confirm Password</label>

                <input @bind="changePwdRequest.ConfirmPwd"  class="form-control" placeholder="Confirm Password" />
            </div>
            <div>
                <button @onclick="SaveNewPassoword" class="btn btn-primary">Save</button>

            </div>
        </Content>
    </DialogTemplates>

</SfDialog>
@code {
    private LoginRequest loginRequest = new LoginRequest();
    private ChangePwdRequest changePwdRequest = new ChangePwdRequest();
    private string UserEmail;
    protected SfDialog ForgotDialog;
    protected SfDialog ChangePwdDialog;
    public bool ForgotinfoDialogflag = true;
    public bool ChangePwdinfoDialogflag = true;
    private async Task Authenticate()
    {
        var loginResponse = await httpClient.PostAsJsonAsync<LoginRequest>("/api/Account/Login", loginRequest);
        if (loginResponse.IsSuccessStatusCode)
        {
            var userSession = await loginResponse.Content.ReadFromJsonAsync<UserSession>();
            var customAuthStateProvider = (CustomAuthenticationStateProvider)authStateProvider;
            await customAuthStateProvider.UpdateAuthenticationState(Task.FromResult(userSession));
            await Task.Delay(5);
            if( userSession.HasChangedDefaultPwd == null )
            {
                //navManager.NavigateTo("/ChangePwd", true);
                if (ChangePwdinfoDialogflag)
                {
                    await ChangePwdDialog.ShowAsync();
                    changePwdRequest.UserId = userSession.UserId;
                    ChangePwdinfoDialogflag = false;
                }
            }
            else if (userSession.Role == "1")
                navManager.NavigateTo("/administratordashboard", true);
            else if (userSession.Role == "2")
                navManager.NavigateTo("/tutordashboard", true);
        }
        else if (loginResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await js.InvokeVoidAsync("alert", "Invalid username or password");
            return;
        }
    }
    protected async Task ShowForgotPwdForm()
    {
        if (ForgotinfoDialogflag)
        {
            await ForgotDialog.ShowAsync();
            ForgotinfoDialogflag = false;
        }
    }
    public void ForgotClosed()
    {
        ForgotinfoDialogflag = true;
    }
    public void ChangePwdClosed()
    {
        ChangePwdinfoDialogflag = true;
    }
    private async Task SaveNewPassoword()
    {
        await Task.Delay(1);
        
        var response = await userService.ChangePassword(changePwdRequest);
        if (response != null)
        {
            await ChangePwdDialog.HideAsync();
        }
    }
}
